# ============================================================
# Cata Log Platform — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com valores reais:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no Git.
# ============================================================

# PostgreSQL
POSTGRES_DB=catalog_db
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_PORT=5433

# API (Spring Boot)
API_PORT=8080

# Web (Nginx)
WEB_PORT=3000
