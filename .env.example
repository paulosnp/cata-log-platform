# ============================================================
# Cata Log Platform — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com valores reais:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no Git.
# ============================================================

# PostgreSQL
POSTGRES_DB=catalog_db
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_PORT=5433

# API (Spring Boot)
API_PORT=8080

# Web (Nginx)
WEB_PORT=3000

# Stream Chat (obter em https://getstream.io/dashboard/)
STREAM_CHAT_API_KEY=sua_api_key_aqui
STREAM_CHAT_API_SECRET=seu_secret_aqui

# Email SMTP (Mailtrap para dev: https://mailtrap.io/)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=seu_username_smtp_aqui
MAIL_PASSWORD=sua_senha_smtp_aqui
MAIL_FROM=nao-responda@catalog.com

# Mercado Pago (obter em https://www.mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui

# Melhor Envio (obter em https://sandbox.melhorenvio.com.br)
MELHORENVIO_TOKEN=seu_token_aqui
